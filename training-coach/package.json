    "check": "tsc --noEmit && node --test lib/model.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}

{
  "name": "personal-703-training-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/cloudflare.mjs dev --local --ip localhost --port 8787",
    "build": "node scripts/cloudflare.mjs deploy --dry-run",
